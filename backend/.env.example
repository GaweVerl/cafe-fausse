FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Allow your frontend origin(s). Use "*" for dev, or a comma-separated list.
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGINS=*

# Prefer a single connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Or set discrete variables instead of DATABASE_URL:
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

